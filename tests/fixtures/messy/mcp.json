      "env": {}
    },
    "filesystem-copy": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/"],
      "env": {}
    },
    "missing-tool": {
      "command": "ghostmcp-nonexistent-binary-9f3k",
